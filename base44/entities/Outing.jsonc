{
  "name": "Outing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Outing title"
    },
    "month_label": {
      "type": "string",
      "description": "Display label e.g. 'March 2026 \u2014 Hawk Mountain Backpacking'"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "departure_time": {
      "type": "string",
      "description": "Departure time e.g. 07:00"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "return_time": {
      "type": "string",
      "description": "Approximate return time"
    },
    "price_per_scout": {
      "type": "string",
      "description": "Cost per scout in dollars"
    },
    "friday_shirt": {
      "type": "string",
      "description": "Class B shirt color for Friday"
    },
    "saturday_shirt": {
      "type": "string",
      "description": "Class B shirt color for Saturday"
    },
    "sunday_shirt": {
      "type": "string",
      "description": "Class B shirt color for Sunday"
    },
    "permission_slip_url": {
      "type": "string",
      "description": "URL to the uploaded permission slip PDF"
    },
    "grubmasters": {
      "type": "string",
      "description": "JSON string mapping patrol name to grubmaster scout name"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ]
}