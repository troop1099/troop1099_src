{
  "name": "Outing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Outing title"
    },
    "month_label": {
      "type": "string",
      "description": "Display label e.g. 'March 2026 \u2014 Hawk Mountain Backpacking'"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "permission_slip_url": {
      "type": "string",
      "description": "URL to the uploaded permission slip PDF"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this outing is currently active/visible"
    }
  },
  "required": [
    "title"
  ]
}