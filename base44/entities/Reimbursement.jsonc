{
  "name": "Reimbursement",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person submitting the reimbursement (verified from the troop roster)"
    },
    "phone": {
      "type": "string",
      "description": "Normalized phone number used to verify identity and show only this submitter's queue"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date the purchase was made"
    },
    "amount": {
      "type": "number",
      "description": "Amount spent in dollars"
    },
    "purpose": {
      "type": "string",
      "description": "What the purchase was for"
    },
    "description": {
      "type": "string",
      "description": "Short description of the purchase"
    },
    "receipt_file_uri": {
      "type": "string",
      "description": "Private file URI of the uploaded receipt"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "denied"
      ],
      "default": "pending",
      "description": "Decision set by the Scoutmaster"
    },
    "scout_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Whether the submitter has dismissed the Scoutmaster's decision"
    },
    "admin_note": {
      "type": "string",
      "description": "Optional note added by the Scoutmaster"
    }
  },
  "required": [
    "name",
    "phone",
    "purchase_date",
    "amount",
    "purpose",
    "receipt_file_uri"
  ]
}