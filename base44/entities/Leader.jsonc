{
  "name": "Leader",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "e.g. Scoutmaster, Assistant Scoutmaster, Committee Chair"
    },
    "email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "adult",
        "youth"
      ],
      "default": "adult"
    },
    "patrol": {
      "type": "string",
      "description": "For youth leaders: patrol name"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "role"
  ]
}