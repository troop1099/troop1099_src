{
  "name": "MeritBadge",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Merit badge name"
    },
    "bsa_url": {
      "type": "string",
      "description": "Official BSA merit badge page URL"
    },
    "image_url": {
      "type": "string",
      "description": "Badge image URL"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the merit badge"
    },
    "requirements": {
      "type": "string",
      "description": "JSON array of requirement strings"
    },
    "eagle_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether the BSA page lists this as Eagle required"
    }
  },
  "required": [
    "name",
    "bsa_url"
  ]
}