{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "category": {
      "type": "string",
      "enum": [
        "trip_docs",
        "health_safety",
        "advancement",
        "governance",
        "fundraising"
      ],
      "description": "Document category"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the uploaded file"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the document"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this document is pinned as a Quick Link"
    }
  },
  "required": [
    "title",
    "category",
    "file_url"
  ]
}