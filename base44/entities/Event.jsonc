{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Event end date for multi-day events"
    },
    "location": {
      "type": "string",
      "description": "Event location"
    },
    "type": {
      "type": "string",
      "enum": [
        "meeting",
        "campout",
        "hike",
        "service",
        "fundraiser",
        "special"
      ],
      "description": "Type of event"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    }
  },
  "required": [
    "title",
    "date",
    "type"
  ]
}