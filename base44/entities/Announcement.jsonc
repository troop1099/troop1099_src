{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Announcement title"
    },
    "body": {
      "type": "string",
      "description": "Announcement body text"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "members"
      ],
      "default": "members",
      "description": "Who can see this announcement"
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}