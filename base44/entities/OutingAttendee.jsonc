{
  "name": "OutingAttendee",
  "type": "object",
  "properties": {
    "outing_id": {
      "type": "string",
      "description": "ID of the related Outing record"
    },
    "scout_name": {
      "type": "string",
      "description": "Scout's full name"
    },
    "patrol": {
      "type": "string",
      "description": "Scout's patrol"
    },
    "attending": {
      "type": "boolean",
      "default": false,
      "description": "Whether this scout is confirmed attending"
    },
    "permission_slip": {
      "type": "boolean",
      "default": false,
      "description": "Permission slip received"
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "Outing fee paid"
    },
    "notes": {
      "type": "string",
      "description": "Notes (e.g. scout request to attend)"
    },
    "request_to_attend": {
      "type": "boolean",
      "default": false,
      "description": "Scout submitted a request to attend outside of the meeting"
    }
  },
  "required": [
    "outing_id",
    "scout_name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}