{
  "name": "AdvancementRequest",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "scoutmaster_conference",
        "board_of_review",
        "blue_card"
      ],
      "description": "Type of advancement request"
    },
    "scout_name": {
      "type": "string",
      "description": "Scout's full name"
    },
    "scout_email": {
      "type": "string",
      "description": "Scout's email"
    },
    "rank": {
      "type": "string",
      "description": "For conference/BOR: rank being pursued"
    },
    "merit_badge": {
      "type": "string",
      "description": "For blue card: merit badge name"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "Requested troop meeting date for SMC/BOR"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "scheduled",
        "completed",
        "canceled",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    }
  },
  "required": [
    "type",
    "scout_name"
  ]
}